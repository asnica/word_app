<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">

      <div class="text-center mb-4">
        <h1 class="display-5 fw-bold text-primary">Ranking</h1>
        <p class="text-muted">正解率ランキング</p>
      </div>

      <% if params[:from_result] == 'true' && @current_user_ranking.present? %>
        <div class="alert alert-warning border-warning border-2 shadow-sm text-center p-4 mb-4 rounded-4">
          <h4 class="alert-heading fw-bold mb-3">お疲れ様でした！</h4>
          <p class="mb-0 fs-5">
            あなたの成績は、<strong><%= @current_user_ranking[:total_questions] %></strong>問中
            <strong><%= @current_user_ranking[:total_correct] %></strong>問正解
            正解率<strong><%= @current_user_ranking[:accuracy] %></strong>%で
            <span class="text-danger fw-bold fs-4"><%= @current_user_ranking[:rank] %>位</span>でした。
          </p>
        </div>
      <% end %>

      <div class="card border-0 shadow-sm overflow-hidden mb-4">
        <div class="card-body p-0">
          <table class="table table-hover align-middle mb-0 text-center">
            <thead class="bg-light text-muted">
              <tr>
                <th class="py-3" style="width: 20%;">順位</th>
                <th class="py-3" style="width: 50%;">名前</th>
                <th class="py-3" style="width: 30%;">正解率</th>
              </tr>
            </thead>
            <tbody>
              <% @rankings.first(5).each do |r| %>
                <tr class="<%= 'table-primary fw-bold' if r[:user].id == current_user.id %>">
                  <td class="py-3">
                    <% if r[:rank] == 1 %>
                      <span class="text-warning"><i class="bi bi-trophy-fill fs-5"></i> 1位</span>
                    <% elsif r[:rank] == 2 %>
                      <span class="text-secondary"><i class="bi bi-trophy-fill fs-5"></i> 2位</span>
                    <% elsif r[:rank] == 3 %>
                      <span style="color: #cd7f32;"><i class="bi bi-trophy-fill fs-5"></i> 3位</span>
                    <% else %>
                      <span class="text-muted"><%= r[:rank] %>位</span>
                    <% end %>
                  </td>
                  
                  <td class="<%= 'text-danger' if r[:user].id == current_user.id %>">
                    <%= r[:user].name %>
                  </td>
                  
                  <td class="text-success fw-bold">
                    <%= r[:accuracy] %>%
                  </td>
                </tr>
              <% end %>

              <% if @rankings.size > 5 %>
                <tr class="bg-light">
                  <td colspan="3" class="py-2 text-muted fs-5">
                    <i class="bi bi-three-dots"></i>
                  </td>
                </tr>
              <% end %>

              <% if @current_user_ranking.present? && @current_user_ranking[:rank] > 5 %>
                <tr class="table-primary fw-bold border-top border-primary border-2">
                  <td class="py-3 fw-bold text-muted">
                    <%= @current_user_ranking[:rank] %>位
                  </td>
                  <td class="text-danger">
                    <%= @current_user_ranking[:user].name %>
                  </td>
                  <td class="text-success fw-bold">
                    <%= @current_user_ranking[:accuracy] %>%
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mt-5">
        <%= link_to quizzes_path, class: "btn btn-primary px-4 py-2 shadow-sm fw-bold d-flex align-items-center justify-content-center" do %>
          <i class="bi bi-card-checklist me-2"></i>問題集ダッシュボードへ
        <% end %>

        <%= link_to root_path, class: "btn btn-outline-secondary px-4 py-2 shadow-sm d-flex align-items-center justify-content-center" do %>
          <i class="bi bi-house-door me-2"></i>メインメニューへ
        <% end %>
      </div>

    </div>
  </div>
</div>