<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">単語タグマスタ</h2>
    <%= link_to "メニューへ戻る", root_path, class: "btn btn-outline-secondary" %>
  </div>

  <% if @user && @user.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @user.errors.full_messages.each do |msg| %>
          <li>
            <%= msg.gsub("Tags name", "タグ名") %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card mb-4 shadow-sm border-primary">
    <div class="card-header bg-primary text-white fw-bold">新規タグ一括登録</div>
    <div class="card-body">
      <%= form_with model: @user, url: create_tags_tags_path, method: :patch, local: true do |form| %>
        <%= cocooned_container id: "tags-form" do %>
          <%= form.fields_for :tags do |tag_form| %>
            <% if tag_form.object.new_record? %>
              <%= render "tag_fields", f: tag_form %>
            <% end %>
          <% end %>
        <div class="links mb-4">
          <%= cocooned_add_item_link "+ タグを追加", 
                                      form, 
                                      :tags,
                                      class: "btn btn-sm btn-secondary",
                                      partial: "tag_fields" %>
        </div>
        <% end %>
        
        <div class="text-end mt-3">
          <%= form.submit "まとめて保存", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  </div>

  <% # 検索セクション %>
  <%= form_with url: tags_path, method: :get, local: true, class: "mb-4" do |f| %>
    <div class="input-group">
      <%= f.text_field :query, value: params[:query], class: "form-control", placeholder: "タグ名で検索（曖昧検索）" %>
      <%= f.submit "検索", class: "btn btn-primary" %>
    </div>
  <% end %>

  <% if @tags.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle bg-white border">
        <thead class="table-light">
          <tr>
            <th>タグ名</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @tags.each do |tag| %>
            <tr>
              <td class="fw-bold"><%= link_to tag.name, 
                                              words_path(search_scope: 'all', tag_ids: [tag.id]), 
                                              data: { turbo: false },
                                              class: "text-decoration-none text-primary fw-bold" %></td>
              <td class="text-end">
                <% is_mine = (tag.user == current_user) %>

                <% if is_mine %>
                  <%= link_to "編集", edit_tag_path(tag, return_to: request.fullpath), class: "btn btn-sm btn-outline-primary me-1" %>
                  <%= link_to "削除", tag_path(tag, return_to: request.fullpath), data: { "turbo-method": :delete, "turbo-confirm": "本当に削除しますか？" }, class: "btn btn-sm btn-outline-danger" %>
                <% else %>
                  <span class="d-inline-block" tabindex="0" data-bs-toggle="tooltip" data-bs-title="作成者のみ編集・削除可能です。">
                    <button class="btn btn-sm btn-outline-secondary me-1" disabled style="pointer-events: none;">編集</button>
                    <button class="btn btn-sm btn-outline-secondary" disabled style="pointer-events: none;">削除</button>
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-center mt-4">
      <%= paginate @tags, window: 1, outer_window: 0 %>
    </div>

  <% else %>
    <div class="text-center py-5 bg-white border rounded shadow-sm">
      <p class="text-muted mb-0 fs-5">
        <i class="bi bi-tag me-2"></i>登録されたタグがありません。
      </p>
    </div>
  <% end %>

</div>