<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">単語一覧</h2>
    <div class="d-flex gap-2">
      <%= link_to words_path(params: params.permit(:query, :tag_id, :search_scope), format: :csv), class: "btn btn-outline-success d-flex align-items-center" do %>
        <i class="bi bi-file-earmark-arrow-down me-1"></i> CSV出力
      <% end %>
      <%= link_to "新規単語登録", new_word_path, class: "btn btn-success" %>
    </div>
  </div>

  <%= form_with url: words_path, method: :get, local: true, class: "mb-4" do |f| %>
    <div class="card shadow-sm border-0 bg-light p-3">
      
      <div class="row g-2 mb-3">
        <div class="col-md-3">
          <%= f.select :search_scope, 
                       options_for_select([['全体', 'all'], ['単語名', 'name'], ['意味', 'meaning'], ['類義語', 'synonym']], params[:search_scope]), 
                       {}, { class: "form-select" } %>
        </div>
        <div class="col-md-7">
          <%= f.text_field :query, value: params[:query], class: "form-control", placeholder: "検索語を入力してください" %>
        </div>
        <div class="col-md-2 d-grid">
          <div class="btn-group">
            <%= f.submit "検索", class: "btn btn-primary" %>
            <% if params[:query].present? || params[:tag_id].present? %>
              <%= link_to "クリア", words_path, class: "btn btn-outline-secondary" %>
            <% end %>
          </div>
        </div>
      </div>

      <div class="row g-2 align-items-center border-top pt-2 mt-1">
        <div class="col-auto">
          <i class="bi bi-funnel text-muted"></i> <span class="text-muted fw-bold" style="font-size: 0.9rem;">タグフィルター:</span>
        </div>
        <div class="col-md-4">
          <%= f.collection_select :tag_id, Tag.all, :id, :name, 
                                  { include_blank: "すべてのタグを表示", selected: params[:tag_id] }, 
                                  { class: "form-select form-select-sm", onchange: "this.form.submit()" } %>
        </div>
      </div>      
    </div>
  <% end %>

  <div class="row g-3">
    <% if @words.any? %>
      <% @words.each do |word| %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm border-0 bg-light">
            <div class="card-body">
              
              <div class="d-flex align-items-center mb-3">
                <% if word.image.attached? %>
                  <%= image_tag word.image, class: "rounded me-3 shadow-sm", style: "width: 60px; height: 60px; object-fit: cover;" %>
                <% else %>
                  <div class="bg-secondary bg-opacity-25 rounded me-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-image text-muted"></i>
                  </div>
                <% end %>

                <div class="ms-1">
                  <h5 class="card-title fw-bold mb-0"><%= word.name %></h5>
                </div>
              </div>
                
              <div class="d-flex flex-wrap gap-1 mb-2">
                <% if word.tags.any? %>
                  <% word.tags.each do |tag| %>
                    <span class="badge bg-info text-dark"><%= tag.name %></span>
                  <% end %>
                <% else %>
                  <span class="badge bg-secondary">タグなし</span>
                <% end %>
              </div>

              <div class="text-muted mb-3" style="font-size: 0.8rem;">
                <i class="bi bi-person"></i> 投稿者: <%= word.user.name %>
              </div>

              <hr>
              
              <p class="card-text mb-1 text-secondary" style="font-size: 0.9rem;">
                <strong>意味：</strong><%= word.meaning %>
              </p>
              
            </div>
            
            <div class="card-footer bg-transparent border-0 text-end pb-3">
              <%= link_to "詳細", word_path(word), class: "btn btn-sm btn-link text-decoration-none" %>

              <% is_mine = (word.user == current_user) %>
              
              <% if is_mine %>
                <%= link_to "編集", edit_word_path(word), class: "btn btn-sm btn-outline-primary" %>
                <%= link_to "削除", word_path(word), data: { "turbo-method": :delete, "turbo-confirm": "本当に削除しますか？" }, class: "btn btn-sm btn-outline-danger" %>
              <% else %>
                <span class="d-inline-block" tabindex="0" data-bs-toggle="tooltip" data-bs-title="作成者のみ編集・削除可能です。">
                  <button class="btn btn-sm btn-outline-secondary me-1" disabled style="pointer-events: none;">編集</button>
                  <button class="btn btn-sm btn-outline-secondary" disabled style="pointer-events: none;">削除</button>
                </span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="col-12 text-center py-5">
        <p class="text-muted">登録された単語がありません。</p>
        <%= link_to "最初の単語を登録する", new_word_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>