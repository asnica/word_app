<meta name="turbo-cache-control" content="no-cache">
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-10">
      
      <div class="text-center mb-5">
        <h6 class="text-muted fw-bold tracking-wide mb-3">採点結果</h6>
        <h1 class="display-1 fw-bold text-primary mb-0">
          <%= @quiz.total_score %> <span class="fs-3 text-muted">/ 10</span>
        </h1>
      </div>

      <div class="card border-0 shadow-sm overflow-hidden mb-4">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table align-middle mb-0">
              <thead class="bg-light text-muted">
                <tr>
                  <th class="px-4 py-3" style="width: 10%">No.</th>
                  <th class="py-3" style="width: 25%">単語</th>
                  <th class="py-3" style="width: 50%">あなたの回答</th>
                  <th class="py-3 text-center" style="width: 15%">判定</th>
                </tr>
              </thead>
              <tbody>
                <% @quiz_items.each do |item| %>
                  <tr class="<%= item.is_correct ? '' : 'table-danger' %>">

                    <td class="px-4 fw-bold text-secondary" style="width: 10%"><%= item.position + 1 %></td>

                    <td class="fw-bold fs-5" style="width: 25%"><%= item.word.name %></td>

                    <td style="width: 50%">
                      <% if item.is_correct %>
                        <span class="text-dark"><%= item.user_choice %></span>
                      <% else %>
                        <span class="text-danger text-decoration-line-through d-block mb-1">
                          <%= item.user_choice.presence || "未回答" %>
                        </span>
                        <span class="text-success fw-bold small d-block">
                          <i class="bi bi-arrow-return-right"></i> 正解: <%= item.word.meaning %>
                        </span>
                      <% end %>
                    </td>

                    <td class="text-center" style="width: 15%">
                      <% if item.is_correct %>
                        <span class="text-success fs-4 fw-bold">〇</span>
                      <% else %>
                        <span class="text-danger fs-4 fw-bold">✕</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-5">
        <% if params[:return_to].present? %>
          <%= link_to params[:return_to], class: "btn btn-outline-primary px-4 shadow-sm" do %>
            <i class="bi bi-house-door me-1"></i> ダッシュボードへ
          <% end %>
        <% else %>
          <%= link_to quizzes_path, class: "btn btn-outline-primary px-4 shadow-sm", data: { turbo: false } do %>
            <i class="bi bi-house-door me-1"></i> ダッシュボードへ
          <% end %>
        <% end %>
        <%= link_to rankings_path(from_result: true), class: "btn btn-primary px-4 shadow-sm fw-bold" do %>
          <i class="bi bi-trophy me-1"></i> ランキングはこちら
        <% end %>
      </div>

    </div>
  </div>
</div>